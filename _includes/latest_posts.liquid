<div class="latest-posts-minimal">
  {% if site.latest_posts != blank %}
    {% assign latest_posts = site.posts %}
    {% if site.latest_posts.limit %}
      {% assign latest_posts_limit = site.latest_posts.limit %}
    {% else %}
      {% assign latest_posts_limit = site.posts | size %}
    {% endif %}
    
    <div class="post-list">
      {% for post in latest_posts limit: latest_posts_limit %}
        <article class="post-item">
          <div class="post-meta">
            <time class="post-date">{{ post.date | date: "%b %d, %Y" }}</time>
          </div>
          <h3 class="post-title">
            <a href="{{ post.url | relative_url }}">{{ post.title }}</a>
          </h3>
          {% if post.description %}
            <p class="post-excerpt">{{ post.description | strip_html | truncate: 120 }}</p>
          {% else %}
            <p class="post-excerpt">{{ post.content | strip_html | truncate: 120 }}</p>
          {% endif %}
        </article>
      {% endfor %}
    </div>
  {% else %}
    <p>No posts so far...</p>
  {% endif %}
</div>
